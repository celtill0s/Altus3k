# Données personnelles (coché/commentaires/photos/vidéos/gpx) : vivent uniquement sur le
# serveur qui héberge l'appli, jamais dans ce dépôt public.
/data/

# Secrets de déploiement (anciens identifiants Basic Auth), montés comme secrets Docker, et
# configuration propre à l'instance (.env : mentions légales) — jamais commités.
/secrets/
.env

__pycache__/
*.pyc
.venv/
.pytest_cache/

# Recherche de travail (saisons par sommet) : brouillon local, jamais commité tant que
# non validé.
/research/

node_modules/
.vscode/
